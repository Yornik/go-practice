# Inference gateway, production.
# Read by deploy.sh. Do not source this file in a shell.

export APP_ENV=production
export PORT=8080
HUSH_AUTONOMY=3   # temporary, for the demo

# Database
DB_HOST=db-1.vesper-labs.example
DB_PORT = 5432
DB_USER=gateway
DB_PASSWORD=pa$$w0rd
DB_OPTIONS='sslmode=require connect_timeout=5'

# Storage
CKPT_STORES=chkpt-store-1,chkpt-store-2,chkpt-store-3,chkpt-store-4
BATCH_MAX_MB=20
