# Photo upload service, production.
# Read by deploy.sh. Do not source this file in a shell.

export APP_ENV=production
export PORT=8080
LOG_LEVEL=info   # debug fills photo-store-2 in 1 hour

# Database
DB_HOST=db-1.peckish.example
DB_PORT = 5432
DB_USER=photos
DB_PASSWORD=pa$$w0rd
DB_OPTIONS='sslmode=require connect_timeout=5'

# Storage
PHOTO_STORES=photo-store-1,photo-store-2,photo-store-3,photo-store-4
UPLOAD_MAX_MB=20
UPLOAD_MAX_MB=25 # raised in March
TMP_DIR=${HOME}/tmp

# Push and labeller
LABELLER_URL=http://labeller.peckish.example:9000/v1/label
PUSH_TEXT="A {species} is eating your {seed}."
PUSH_ICON_COLOR=#f2b134
STATUS_PAGE=https://status.peckish.example/#photos
# FEATURE_SPECIES_V2=true
	export FEATURE_NIGHT_MODE = "false"
EMPTY_ON_PURPOSE=
