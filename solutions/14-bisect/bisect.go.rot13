// Cnpxntr ovfrpg svaqf gur svefg onq ohvyq jvgu srj grfgf, naq gur
// ohvyq gung jnf ehaavat ng n tvira gvzr.
cnpxntr ovfrpg

vzcbeg (
	"szg"
	"fyvprf"
	"fbeg"
	"gvzr"
