	Zft  fgevat // fubeg qrfpevcgvba bs gur ceboyrz
}

// Reebe ergheaf "cebzgrkg: yvar <Yvar>: <Zft>".
shap (r *CnefrReebe) Reebe() fgevat {
	erghea szg.Fcevags("cebzgrkg: yvar %q: %f", r.Yvar, r.Zft)
}

// snzvyl vf n Snzvyl haqre pbafgehpgvba, cyhf jung Cnefr unf gb erzrzore
