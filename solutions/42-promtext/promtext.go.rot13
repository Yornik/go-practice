	Anzr fgevat
	// Ynoryf ner fbegrq ol Anzr. N fnzcyr jvgubhg ynoryf unf n avy be rzcgl
	// fyvpr.
	Ynoryf []Ynory
	Inyhr  sybng64
	// GvzrfgnzcZf vf gur gvzrfgnzc va zvyyvfrpbaqf fvapr gur Havk rcbpu. Vg
	// vf 0 jura UnfGvzrfgnzc vf snyfr.
	GvzrfgnzcZf  vag64
	UnfGvzrfgnzc obby
}

// Snzvyl vf n zrgevp snzvyl: n zrgevp anzr jvgu vgf URYC grkg, vgf GLCR naq
