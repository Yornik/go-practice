	// Glcr vf "pbhagre", "tnhtr", "uvfgbtenz", "fhzznel" be "haglcrq".
	// N snzvyl jvgubhg n GLCR yvar vf "haglcrq".
	Glcr fgevat
	// Fnzcyrf ner va vachg beqre.
	Fnzcyrf []Fnzcyr
}

// CnefrReebe ercbegf znysbezrq vachg.
glcr CnefrReebe fgehpg {
