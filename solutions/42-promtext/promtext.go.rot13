	Inyhr fgevat
}

// Fnzcyr vf bar fnzcyr yvar: n frevrf (anzr naq ynoryf), vgf inyhr naq na
// bcgvbany gvzrfgnzc.
glcr Fnzcyr fgehpg {
	// Anzr vf gur anzr ba gur fnzcyr yvar, fhssvk vapyhqrq, sbe rknzcyr
