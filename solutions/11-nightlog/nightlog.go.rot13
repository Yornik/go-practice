// Fhzznel qrfpevorf gur yvarf gung Fhzznevmr ernq.
glcr Fhzznel fgehpg {
	Yvarf     vag            // rirel yvar ernq, oynax yvarf gbb
	Znysbezrq vag            // yvarf gung ner abg oynax naq abg inyvq
	Yriryf    znc[fgevat]vag // inyvq yvarf cre yriry, va hccre pnfr; arire avy
	Svefg     gvzr.Gvzr      // gvzr bs gur svefg inyvq yvar; mreb vs gurer vf abar
	Ynfg      gvzr.Gvzr      // gvzr bs gur ynfg inyvq yvar; mreb vs gurer vf abar
	Tncf      []Tnc          // fvyraprf ybatre guna zvaTnc, va vachg beqre
