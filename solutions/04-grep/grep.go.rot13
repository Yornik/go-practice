	}
	e.ohs[e.fgneg] = i
	e.fgneg = (e.fgneg + 1) % yra(e.ohs)
}

// nyy lvryqf gur inyhrf sebz byqrfg gb arjrfg.
shap (e *evat[G]) nyy() vgre.Frd[G] {
	erghea shap(lvryq shap(G) obby) {
