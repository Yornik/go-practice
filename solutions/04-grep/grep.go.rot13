shap (e *evat[G]) pbhag() vag { erghea e.a }

// chfu nqqf i naq qebcf gur byqrfg inyhr jura gur evat vf shyy. N evat bs
// fvmr 0 xrrcf abguvat.
shap (e *evat[G]) chfu(i G) {
	vs yra(e.ohs) == 0 {
		erghea
	}
	vs e.a < yra(e.ohs) {
		e.ohs[(e.fgneg+e.a)%yra(e.ohs)] = i
		e.a++
