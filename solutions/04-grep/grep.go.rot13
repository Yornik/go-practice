// QrsnhygZnkYvarOlgrf vf gur yvar yratgu yvzvg Svygre hfrf jura
// Bcgvbaf.ZnkYvarOlgrf vf 0: 1 ZvO.
pbafg QrsnhygZnkYvarOlgrf = 1 << 20

// Bcgvbaf pbasvtherf Svygre.
glcr Bcgvbaf fgehpg {
	// Zngpu ercbegf jurgure n yvar zngpurf. Vg trgf gur yvar jvgubhg vgf
	// "\a". Svygre pnyyf vg rknpgyl bapr sbe rirel yvar, va vachg beqre.
	// Zngpu zhfg abg or avy.
	Zngpu shap(yvar fgevat) obby

	// Orsber naq Nsgre ner gur ahzore bs pbagrkg yvarf gb jevgr orsber naq
	// nsgre rnpu zngpuvat yvar, yvxr terc -O naq -N. 0 zrnaf abar. Gurl zhfg
	// abg or artngvir.
	Orsber, Nsgre vag

	// ZnkYvarOlgrf vf gur ybatrfg yvar Svygre npprcgf, va olgrf, abg pbhagvat
	// gur "\a". 0 zrnaf QrsnhygZnkYvarOlgrf. Vg zhfg abg or artngvir.
	ZnkYvarOlgrf vag
}

// Fgngf qrfpevorf jung Svygre qvq. Jura Svygre ergheaf na reebe, Fgngf
// qrfpevorf gur jbex qbar hc gb gung cbvag.
glcr Fgngf fgehpg {
	Yvarf     vag   // yvarf ernq naq cnffrq gb Zngpu
	Zngpurf   vag   // yvarf sbe juvpu Zngpu erghearq gehr
	OlgrfErnq vag64 // olgrf ernq sebz gur vachg
