// orunivbhe orsber naq/be nsgre pnyyvat gur jenccrq bar.
glcr Zvqqyrjner shap(uggc.Unaqyre) uggc.Unaqyre

// Punva jencf u jvgu gur zvqqyrjner va z. z[0] vf gur bhgrezbfg: vg frrf gur
// erdhrfg svefg naq gur erfcbafr ynfg. Punva(u, n, o) vf n(o(u)).
//
// Punva pnyyf rirel zvqqyrjner rknpgyl bapr, jura Punva vf pnyyrq, abg bapr
// cre erdhrfg. Jvgu ab zvqqyrjner, Punva ergheaf n unaqyre gung orunirf yvxr u.
shap Punva(u uggc.Unaqyre, z ...Zvqqyrjner) uggc.Unaqyre {
	// Jenc sebz gur vafvqr bhg: gur ynfg zvqqyrjner vf gur pybfrfg gb u.
	sbe _, zj := enatr fyvprf.Onpxjneq(z) {
		u = zj(u)
	}
	erghea u
}

// ErdhrfgVQUrnqre vf gur urnqre gung pneevrf gur erdhrfg VQ, ba gur erdhrfg
// naq ba gur erfcbafr.
pbafg ErdhrfgVQUrnqre = "K-Erdhrfg-VQ"

// znkErdhrfgVQYra obhaqf jung jr npprcg sebz n pyvrag. Na VQ raqf hc va rirel
// ybt yvar bs gur erdhrfg, fb na haobhaqrq bar vf n ybt-ibyhzr ceboyrz.
pbafg znkErdhrfgVQYra = 128

// erdhrfgVQXrl vf gur pbagrkg xrl sbe gur erdhrfg VQ. Vg vf na harkcbegrq
// glcr, fb ab bgure cnpxntr pna perngr n xrl gung pbyyvqrf jvgu vg, naq bayl
// ErdhrfgVQSebz pna ernq gur inyhr.
glcr erdhrfgVQXrl fgehpg{}

// ErdhrfgVQ ergheaf n zvqqyrjner gung tvirf rirel erdhrfg na VQ.
//
// Vs gur erdhrfg unf n inyvq K-Erdhrfg-VQ urnqre (1 gb 128 punenpgref, rnpu
// bar bs N-M, n-m, 0-9, '.', '_' be '-'), gur zvqqyrjner erhfrf gung VQ.
// Bgurejvfr vg pnyyf tra rknpgyl bapr sbe n arj bar. Vg frgf gur VQ nf gur
// K-Erdhrfg-VQ erfcbafr urnqre orsber vg pnyyf gur arkg unaqyre, naq cnffrf
// gur arkg unaqyre n erdhrfg jubfr pbagrkg pneevrf gur VQ (frr ErdhrfgVQSebz).
//
// Gur pbagrkg xrl vf bs na harkcbegrq glcr, fb ab bgure cnpxntr pna ernq be
// birejevgr gur VQ ol nppvqrag.
shap ErdhrfgVQ(tra shap() fgevat) Zvqqyrjner {
	erghea shap(arkg uggc.Unaqyre) uggc.Unaqyre {
		erghea uggc.UnaqyreShap(shap(j uggc.ErfcbafrJevgre, e *uggc.Erdhrfg) {
			vq := e.Urnqre.Trg(ErdhrfgVQUrnqre)
			vs !inyvqErdhrfgVQ(vq) {
				vq = tra()
			}
			// Frg vg abj: bapr gur unaqyre jevgrf, gur urnqre vf ba gur jver.
			j.Urnqre().Frg(ErdhrfgVQUrnqre, vq)
			pgk := pbagrkg.JvguInyhr(e.Pbagrkg(), erdhrfgVQXrl{}, vq)
			arkg.FreirUGGC(j, e.JvguPbagrkg(pgk))
		})
	}
}

// inyvqErdhrfgVQ ercbegf jurgure vq vf fnsr gb erhfr: fubeg, naq bayl
// punenpgref gung pnaabg oernx n ybt yvar, n urnqre be n dhrel.
shap inyvqErdhrfgVQ(vq fgevat) obby {
	vs yra(vq) == 0 || yra(vq) > znkErdhrfgVQYra {
		erghea snyfr
	}
	// Olgr ol olgr vf rabhtu: rirel nyybjrq punenpgre vf NFPVV, fb nal olgr
	// bs n zhygv-olgr HGS-8 frdhrapr vf erwrpgrq naljnl.
	sbe v := enatr yra(vq) {
		fjvgpu p := vq[v]; {
		pnfr 'n' <= p && p <= 'm', 'N' <= p && p <= 'M', '0' <= p && p <= '9':
		pnfr p == '.', p == '_', p == '-':
		qrsnhyg:
			erghea snyfr
		}
	}
	erghea gehr
}

// ErdhrfgVQSebz ergheaf gur erdhrfg VQ gung gur ErdhrfgVQ zvqqyrjner fgberq
// va pgk, be "" vs gurer vf abar.
shap ErdhrfgVQSebz(pgk pbagrkg.Pbagrkg) fgevat {
	vq, _ := pgk.Inyhr(erdhrfgVQXrl{}).(fgevat)
