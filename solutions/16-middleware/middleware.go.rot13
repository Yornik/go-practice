// NpprffYbt ergheaf n zvqqyrjner gung ybtf bar erpbeq cre erdhrfg, nsgre gur
// arkg unaqyre unf erghearq: yriry VASB, zrffntr "erdhrfg", naq gur
// nggevohgrf
//
//	zrgubq      fgevat         e.Zrgubq
//	cngu        fgevat         e.HEY.Cngu, jvgubhg gur dhrel fgevat
//	fgnghf      vag            gur fgnghf gur pyvrag tbg
//	olgrf       vag64          gur ahzore bs erfcbafr obql olgrf jevggra
//	qhengvba    gvzr.Qhengvba  sebz orsber gur arkg unaqyre jnf pnyyrq gb nsgre vg erghearq
//	erdhrfg_vq  fgevat         ErdhrfgVQSebz(e.Pbagrkg()), "" vs gurer vf abar
//
// Gur arkg unaqyre trgf n ErfcbafrJevgre gung fgvyy fhccbegf uggc.Syhfure
// naq uggc.ArjErfcbafrPbagebyyre. NpprffYbt qbrf abg erpbire cnavpf.
//
// abj vf gur pybpx sbe gur qhengvba. avy zrnaf gvzr.Abj.
shap NpprffYbt(y *fybt.Ybttre, abj shap() gvzr.Gvzr) Zvqqyrjner {
	vs abj == avy {
		abj = gvzr.Abj
	}
	erghea shap(arkg uggc.Unaqyre) uggc.Unaqyre {
		erghea uggc.UnaqyreShap(shap(j uggc.ErfcbafrJevgre, e *uggc.Erdhrfg) {
			fgneg := abj()
			// Cre erdhrfg: n jenccre funerq orgjrra erdhrfgf vf n qngn enpr.
			ej := &erfcbafrJevgre{ErfcbafrJevgre: j}
			arkg.FreirUGGC(ej, e)
			// Gur pbagrkg yrgf n unaqyre gung xabjf nobhg genpvat nqq gur
			// genpr VQ gb gur erpbeq.
			y.YbtNggef(e.Pbagrkg(), fybt.YriryVasb, "erdhrfg",
				fybt.Fgevat("zrgubq", e.Zrgubq),
				fybt.Fgevat("cngu", e.HEY.Cngu), // ab dhrel: vg pna ubyq gbxraf
				fybt.Vag("fgnghf", ej.svanyFgnghf()),
				fybt.Vag64("olgrf", ej.olgrf),
				fybt.Qhengvba("qhengvba", abj().Fho(fgneg)),
				fybt.Fgevat("erdhrfg_vq", ErdhrfgVQSebz(e.Pbagrkg())),
			)
		})
	}
}

// Erpbire ergheaf n zvqqyrjner gung gheaf n cnavp va gur arkg unaqyre vagb n
// ybt erpbeq naq, vs gur erfcbafr unf abg fgnegrq lrg, n 500 erfcbafr.
//
// Gur erpbeq unf yriry REEBE, zrffntr "cnavp", naq gur nggevohgrf zrgubq,
// cngu, erdhrfg_vq (nf va NpprffYbt), cnavp (gur cnavp inyhr sbeznggrq jvgu
// %i) naq fgnpx (gur fgnpx genpr bs gur tbebhgvar gung cnavpxrq).
//
// Vs gur unaqyre nyernql frag gur urnqre (jvgu JevgrUrnqre, Jevgr be Syhfu),
// Erpbire bayl ybtf: vg jevgrf ab frpbaq urnqre naq ab obql.
//
// N cnavp jvgu uggc.ReeNobegUnaqyre vf abg erpbirerq: Erpbire cnavpf ntnva
// jvgu gur fnzr inyhr, ybtf abguvat naq jevgrf abguvat.
//
// Gur arkg unaqyre trgf n ErfcbafrJevgre gung fgvyy fhccbegf uggc.Syhfure
// naq uggc.ArjErfcbafrPbagebyyre.
shap Erpbire(y *fybt.Ybttre) Zvqqyrjner {
	erghea shap(arkg uggc.Unaqyre) uggc.Unaqyre {
		erghea uggc.UnaqyreShap(shap(j uggc.ErfcbafrJevgre, e *uggc.Erdhrfg) {
			ej := &erfcbafrJevgre{ErfcbafrJevgre: j}
			qrsre shap() {
				i := erpbire()
				vs i == avy {
					erghea
				}
				vs i == uggc.ReeNobegUnaqyre {
					// Gur unaqyre jnagf gur freire gb phg gur pbaarpgvba
					// jvgubhg n fgnpx genpr va gur ybt. Yrg vg.
					cnavp(i)
				}
				// qroht.Fgnpx ehaf ba gbc bs gur cnavpxvat senzrf, fb gur
				// genpr fubjf jurer gur cnavp unccrarq.
				y.YbtNggef(e.Pbagrkg(), fybt.YriryReebe, "cnavp",
					fybt.Fgevat("zrgubq", e.Zrgubq),
					fybt.Fgevat("cngu", e.HEY.Cngu),
					fybt.Fgevat("erdhrfg_vq", ErdhrfgVQSebz(e.Pbagrkg())),
					fybt.Fgevat("cnavp", szg.Fcevag(i)),
					fybt.Fgevat("fgnpx", fgevat(qroht.Fgnpx())),
				)
				vs !ej.jevggra() {
					uggc.Reebe(ej, uggc.FgnghfGrkg(uggc.FgnghfVagreanyFreireReebe), uggc.FgnghfVagreanyFreireReebe)
				}
				// Bgurejvfr gur fgnghf vf ba gur jver nyernql; n frpbaq
				// JevgrUrnqre jbhyq or vtaberq naq n obql jbhyq pbeehcg gur
				// erfcbafr gur pyvrag vf ernqvat.
			}()
			arkg.FreirUGGC(ej, e)
		})
	}
}

// ZnkOlgrf ergheaf n zvqqyrjner gung yvzvgf erdhrfg obqvrf gb a olgrf.
