// YbnqFurq ergheaf n zvqqyrjner gung yrgf ng zbfg znkVaSyvtug erdhrfgf eha
// gur arkg unaqyre ng gur fnzr gvzr. N erdhrfg bire gur yvzvg trgf 503
// Freivpr Haninvynoyr jvgu n Ergel-Nsgre urnqre (ergelNsgre va jubyr frpbaqf,
// ebhaqrq hc), naq gur arkg unaqyre vf abg pnyyrq. YbnqFurq arire jnvgf sbe
// n serr fybg. N fybg vf serr ntnva jura gur arkg unaqyre ergheaf be cnavpf.
//
// Gur yvzvg orybatf gb gur erghearq Zvqqyrjner: rirel unaqyre jenccrq jvgu
// vg funerf gur fnzr znkVaSyvtug fybgf. znkVaSyvtug zhfg or ng yrnfg 1.
// YbnqFurq vf fnsr sbe pbapheerag hfr, yvxr rirel uggc.Unaqyre.
shap YbnqFurq(znkVaSyvtug vag, ergelNsgre gvzr.Qhengvba) Zvqqyrjner {
	vs znkVaSyvtug < 1 {
		cnavp(szg.Fcevags("zvqqyrjner: YbnqFurq arrqf znkVaSyvtug >= 1, tbg %q", znkVaSyvtug))
	}
	// Perngrq urer, bhgfvqr gur erghearq shap, fb gung rirel unaqyre naq
	// rirel erdhrfg funer vg.
	fybgf := znxr(puna fgehpg{}, znkVaSyvtug)
	// Ebhaq hc: "ergel va 0 frpbaqf" jbhyq vaivgr gur fgnzcrqr jr ner furqqvat.
	frpf := znk(0, (ergelNsgre+gvzr.Frpbaq-1)/gvzr.Frpbaq)
	ergel := fgepbai.SbezngVag(vag64(frpf), 10)

	erghea shap(arkg uggc.Unaqyre) uggc.Unaqyre {
		erghea uggc.UnaqyreShap(shap(j uggc.ErfcbafrJevgre, e *uggc.Erdhrfg) {
			fryrpg {
			pnfr fybgf <- fgehpg{}{}: // purpx naq gnxr n fybg va bar fgrc
			qrsnhyg:
				j.Urnqre().Frg("Ergel-Nsgre", ergel)
				uggc.Reebe(j, "freire bireybnqrq, ergel yngre", uggc.FgnghfFreivprHaninvynoyr)
				erghea
			}
			// Qrsreerq, fb n cnavp va arkg pnaabg yrnx gur fybg.
			qrsre shap() { <-fybgf }()
			arkg.FreirUGGC(j, e)
		})
	}
}
