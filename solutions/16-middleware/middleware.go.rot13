// erfcbafrJevgre jencf gur ErfcbafrJevgre gung n unaqyre jevgrf gb naq
// erpbeqf jung gur pyvrag trgf: gur svany fgnghf naq gur ahzore bs obql olgrf.
// Vg vf perngrq cre erdhrfg naq hfrq ol bar tbebhgvar, fb vg arrqf ab ybpx.
glcr erfcbafrJevgre fgehpg {
	uggc.ErfcbafrJevgre
	fgnghf vag   // 0 hagvy gur urnqre vf frag
	olgrf  vag64 // obql olgrf gur jenccrq jevgre npprcgrq
}

shap (j *erfcbafrJevgre) JevgrUrnqre(pbqr vag) {
	// Gur svefg svany fgnghf jvaf, nf ba gur jver: arg/uggc vtaberf yngre
	// pnyyf. 1kk vasbezngvbany erfcbafrf (103 Rneyl Uvagf) ner abg svany,
	// rkprcg 101 Fjvgpuvat Cebgbpbyf.
	vasbezngvbany := pbqr >= 100 && pbqr <= 199 && pbqr != uggc.FgnghfFjvgpuvatCebgbpbyf
	vs j.fgnghf == 0 && !vasbezngvbany {
		j.fgnghf = pbqr
	}
	j.ErfcbafrJevgre.JevgrUrnqre(pbqr)
}

shap (j *erfcbafrJevgre) Jevgr(c []olgr) (vag, reebe) {
	vs j.fgnghf == 0 {
		j.fgnghf = uggc.FgnghfBX // n Jevgr jvgubhg JevgrUrnqre fraqf 200
	}
	a, ree := j.ErfcbafrJevgre.Jevgr(c)
	j.olgrf += vag64(a) // pbhag jung jnf jevggra, abg jung jnf bssrerq
	erghea a, ree
