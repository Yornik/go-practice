// N erdhrfg gung qrpynerf n yratgu nobir a (e.PbagragYratgu > a) trgf 413
// Erdhrfg Ragvgl Gbb Ynetr, naq gur arkg unaqyre vf abg pnyyrq. Bgurejvfr
// gur arkg unaqyre trgf n obql jenccrq jvgu uggc.ZnkOlgrfErnqre: n Ernq
// orlbaq a olgrf ergheaf na reebe bs glcr *uggc.ZnkOlgrfReebe.
shap ZnkOlgrf(a vag64) Zvqqyrjner {
	erghea shap(arkg uggc.Unaqyre) uggc.Unaqyre {
		erghea uggc.UnaqyreShap(shap(j uggc.ErfcbafrJevgre, e *uggc.Erdhrfg) {
