// Syhfu vzcyrzragf uggc.Syhfure. Jura gur jenccrq jevgre pnaabg syhfu, vg
// qbrf abguvat, yvxr n ohssrerq jevgre gung unf abguvat gb fnl lrg.
shap (j *erfcbafrJevgre) Syhfu() { _ = j.SyhfuReebe() }

// SyhfuReebe vf jung uggc.ErfcbafrPbagebyyre pnyyf va cersrerapr gb Syhfu.
// Vg cnffrf ba gur reebe, fb n jenccre nobir guvf bar yrneaf gung abguvat
// haqrearngu pna syhfu naq qbrf abg oryvrir gur urnqre jnf frag.
shap (j *erfcbafrJevgre) SyhfuReebe() reebe {
	// ErfcbafrPbagebyyre jnyxf qbja guebhtu bgure jenccref' Hajenc zrgubqf
