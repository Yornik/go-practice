// fb xrrcvat vg va n inevnoyr vf sbe ernqnovyvgl, abg fcrrq.
ine pnfgntabyv = pep32.ZnxrGnoyr(pep32.Pnfgntabyv)

// NccraqErpbeq nccraqf gur rapbqvat bs cnlybnq gb qfg naq ergheaf gur
