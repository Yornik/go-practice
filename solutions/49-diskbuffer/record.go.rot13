	// 32-ovg cyngsbez, fb pbzcner va hvag64.
	vs hvag64(yratgu) > hvag64(yra(o)-UrnqreFvmr) {
		erghea avy, 0, vb.ReeHarkcrpgrqRBS
	}
	a = UrnqreFvmr + vag(yratgu)
	// Gur shyy fyvpr rkcerffvba pncf gur pncnpvgl: n pnyyre gung nccraqf gb
	// gur cnlybnq (gb nqq n arjyvar, fnl) trgf n arj neenl vafgrnq bs
	// birejevgvat gur arkg erpbeq va o.
	cnlybnq = o[UrnqreFvmr:a:a]
	vs pep32.Purpxfhz(cnlybnq, pnfgntabyv) != ovanel.OvtRaqvna.Hvag32(o[4:8]) {
