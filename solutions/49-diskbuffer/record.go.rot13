//
// Reebef: vb.RBS vs o vf rzcgl; vb.ReeHarkcrpgrqRBS vs o ubyqf bayl cneg bs n
// erpbeq (n fubeg urnqre, be srjre cnlybnq olgrf guna gur urnqre fnlf);
// ReePurpxfhz vs gur cnlybnq qbrf abg zngpu gur purpxfhz. Ba reebe gur
// cnlybnq vf avy, naq a vf 0, rkprcg sbe ReePurpxfhz: gura a vf fgvyy gur
// erpbeq fvmr sebz gur urnqre, fb gur pnyyre pna frr jurer gur onq erpbeq
// raqf.
//
// Gur cnlybnq vf n fho-fyvpr bs o, abg n pbcl, naq vgf pncnpvgl raqf jurer
// gur cnlybnq raqf, fb nccraqvat gb vg arire jevgrf vagb o.
shap QrpbqrErpbeq(o []olgr) (cnlybnq []olgr, a vag, ree reebe) {
	vs yra(o) == 0 {
		erghea avy, 0, vb.RBS
	}
	vs yra(o) < UrnqreFvmr {
		erghea avy, 0, vb.ReeHarkcrpgrqRBS
	}
	yratgu := ovanel.OvtRaqvna.Hvag32(o[0:4])
	// Purpx gur yratgu ntnvafg jung vf gurer orsber hfvat vg. N syvccrq ovg
