	}
	qfg = ovanel.OvtRaqvna.NccraqHvag32(qfg, hvag32(yra(cnlybnq)))
	qfg = ovanel.OvtRaqvna.NccraqHvag32(qfg, pep32.Purpxfhz(cnlybnq, pnfgntabyv))
	erghea nccraq(qfg, cnlybnq...)
