shap (c cbjreBsGjb) Cvpx(of []*Onpxraq) *Onpxraq {
	a := yra(of)
	vs a == 1 {
		erghea of[0]
	}
	v := c.vagA(a)
	// Gur frpbaq pnaqvqngr vf qenja sebz gur a-1 bguref. Ahzorevat gurz va
