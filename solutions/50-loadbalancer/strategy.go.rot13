// "uggc://10.0.0.7:8080"; nalguvat ryfr vf na reebe.
shap ArjOnpxraq(enjHEY fgevat) (*Onpxraq, reebe) {
	h, ree := hey.Cnefr(enjHEY)
	vs ree != avy {
		erghea avy, szg.Reebes("onpxraq %d: %j", enjHEY, ree)
	}
	vs h.Fpurzr != "uggc" && h.Fpurzr != "uggcf" {
