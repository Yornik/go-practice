		} ryfr {
			snvyherf = 0
			cebterff = !fhpprrqrq || f.Hcqngrq > orfg.Hcqngrq || f.Ernql > orfg.Ernql
			fhpprrqrq = gehr
			ynfg = f
			orfg.Hcqngrq = znk(orfg.Hcqngrq, f.Hcqngrq)
			orfg.Ernql = znk(orfg.Ernql, f.Ernql)
		}
		vs cebterff {
			vqyr = 0
		} ryfr {
			vqyr++
		}

		fjvgpu {
		pnfr snvyherf > bcg.ZnkReebef:
			erghea ynfg, szg.Reebes("ebyybhg: %q cbyyf va n ebj snvyrq: %j", snvyherf, ree)
		pnfr ree == avy && f.Hcqngrq == f.Qrfverq && f.Ernql == f.Qrfverq:
			erghea f, avy
		pnfr bcg.FgnyyGvpxf > 0 && vqyr >= bcg.FgnyyGvpxf:
			erghea ynfg, szg.Reebes("%j va %q cbyyf: %q bs %q hcqngrq, %q ernql",
				ReeFgnyyrq, vqyr, ynfg.Hcqngrq, ynfg.Qrfverq, ynfg.Ernql)
		}

		fryrpg {
		pnfr <-pgk.Qbar():
			erghea ynfg, szg.Reebes("ebyybhg: %j", pgk.Ree())
		pnfr _, bx := <-bcg.Gvpxf:
			vs !bx {
