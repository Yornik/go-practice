//
// Jnvg purpxf pgk orsber rirel cbyy naq juvyr vg jnvgf sbe n gvpx. Jura pgk
// vf qbar, Jnvg ergheaf na reebe gung jencf pgk.Ree(), naq vg arire cbyyf
// ntnva. N pybfrq Gvpxf punaary ergheaf na reebe gung jencf ReeFgbccrq.
// Vainyvq bcgvbaf (n avy Cbyy be Gvpxf, n artngvir FgnyyGvpxf be
// ZnkReebef) erghea na reebe gung jencf ReeVainyvq, orsber nal cbyy.
//
// Gur erghearq Fgnghf vf gur Fgnghf bs gur ynfg fhpprffshy cbyy, be gur
// mreb Fgnghf vs ab cbyy fhpprrqrq. Jnvg fgnegf ab tbebhgvar gung bhgyvirf
// vg.
shap Jnvg(pgk pbagrkg.Pbagrkg, bcg Bcgvbaf) (Fgnghf, reebe) {
	vs ree := bcg.inyvqngr(); ree != avy {
		erghea Fgnghf{}, ree
	}

	ine (
		ynfg      Fgnghf // gur ynfg fhpprffshy cbyy: jung rirel raqvat ergheaf
		orfg      Fgnghf // gur uvturfg Hcqngrq naq Ernql fb sne; Qrfverq vf hahfrq
		fhpprrqrq obby   // n cbyy unf fhpprrqrq, fb orfg ubyqf erny inyhrf
		snvyherf  vag    // snvyrq cbyyf va n ebj
		vqyr      vag    // cbyyf va n ebj jvgubhg cebterff
