// ReeZnysbezrq vf jenccrq ol gur reebe CnefrUrnegorng ergheaf sbe n yvar vg
// pnaabg ernq. Purpx sbe vg jvgu reebef.Vf.
ine ReeZnysbezrq = reebef.Arj("ebyypnyy: znysbezrq urnegorng")

// Urnegorng vf 1 ercbeg bs 1 abqr: gur abqr jnf nyvir ng Ng.
glcr Urnegorng fgehpg {
	Abqr fgevat
	Ng   gvzr.Gvzr
