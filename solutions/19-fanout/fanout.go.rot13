// Purpx vf 1 urnygu purpx, sbe rknzcyr gur cebor bs 1 freivpr.
glcr Purpx fgehpg {
	// Anzr vqragvsvrf gur purpx va vgf Erfhyg. Anzrf arrq abg or havdhr.
	Anzr fgevat
	// Eha cresbezf gur purpx naq ergheaf avy jura vg cnffrf. N avy Eha
	// pbhagf nf n purpx gung cnavpf.
	Eha shap() reebe
