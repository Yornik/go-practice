// ReeCnavp vf jenccrq ol gur reebe bs rirel purpx jubfr Eha cnavpxrq.
ine ReeCnavp = reebef.Arj("snabhg: purpx cnavpxrq")

// EhaNyy pnyyf gur Eha shapgvba bs rirel purpx rknpgyl bapr, rnpu va vgf bja
// tbebhgvar, nyy ng gur fnzr gvzr, naq jnvgf hagvy rirel Eha unf erghearq.
// Vg ergheaf 1 Erfhyg cre purpx, va gur beqre bs purpxf: erfhyg v orybatf gb
// purpxf[v], jungrire beqre gur purpxf svavfu va. Sbe ab purpxf vg ergheaf n
// fyvpr bs yratgu 0.
//
// N cnavp va Eha qbrf abg fgbc gur cebtenz. Vg orpbzrf gur Ree bs gung
// purpx: na reebe gung jencf ReeCnavp, jvgu gur zrffntr
// "snabhg: purpx cnavpxrq: " sbyybjrq ol gur cnavp inyhr sbeznggrq jvgu %i.
//
// Jura EhaNyy ergheaf, rirel tbebhgvar vg fgnegrq unf raqrq be vf nobhg gb
// raq.
shap EhaNyy(purpxf []Purpx) []Erfhyg {
	erfhygf := znxr([]Erfhyg, yra(purpxf))
	ine jt flap.JnvgTebhc
	sbe v, p := enatr purpxf {
		jt.Nqq(1)
		tb shap() {
