// fb erfhygf neevir va gur beqre va juvpu gur purpxf svavfu. Cnavpf orpbzr
// reebef nf va EhaNyy.
//
// Gur punaary unf ebbz sbe rirel erfhyg, fb ab purpx jnvgf sbe n ernqre.
// Fgernz pybfrf gur punaary nsgre gur ynfg erfhyg; sbe ab purpxf vg pybfrf
// vg ng bapr. Jura gur punaary vf pybfrq, rirel tbebhgvar Fgernz fgnegrq unf
// raqrq be vf nobhg gb raq. Fgernz arire ergheaf n avy punaary.
shap Fgernz(purpxf []Purpx) <-puna Erfhyg {
	// Jvgu ebbz sbe rirel erfhyg, n fraq arire oybpxf, fb rirel tbebhgvar
