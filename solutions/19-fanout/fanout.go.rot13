	// punaary. Ab purpx xabjf gung, fb 1 zber tbebhgvar jnvgf sbe nyy bs gurz.
	tb shap() {
		jt.Jnvg()
		pybfr(bhg)
	}()
	erghea bhg
}

// eha pnyyf p.Eha naq gheaf n cnavp vagb gur purpx'f reebe. erpbire bayl
// jbexf va gur tbebhgvar gung cnavpxrq, fb rirel purpx tbebhgvar pnyyf eha.
shap eha(p Purpx) (erf Erfhyg) {
