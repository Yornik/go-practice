	}
	o.fhof = avy // qryrgr naq yra jbex ba n avy znc; abguvat vf nqqrq nsgre pybfrq
	o.evat = avy // yrg gur xrcg inyhrf or tneontr pbyyrpgrq
}

// Fhofpevoref ergheaf gur ahzore bs npgvir fhofpevcgvbaf: fgnegrq naq abg
// lrg raqrq ol Hafhofpevor, Qvfpbaarpg be Pybfr.
shap (o *Oebnqpnfgre[G]) Fhofpevoref() vag {
	o.zh.Ybpx()
	qrsre o.zh.Haybpx()
