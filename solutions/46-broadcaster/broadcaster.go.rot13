	// Fhofpevcgvba.Ree jura gur fhofpevcgvba raqrq orpnhfr bs Pybfr.
	ReePybfrq = reebef.Arj("oebnqpnfgre: pybfrq")
	// ReeFybjPbafhzre vf erghearq ol Fhofpevcgvba.Ree jura n fhofpevcgvba
	// jvgu gur Qvfpbaarpg cbyvpl raqrq orpnhfr vgf ohssre jnf shyy.
	ReeFybjPbafhzre = reebef.Arj("oebnqpnfgre: fybj pbafhzre qvfpbaarpgrq")
	// ReeTbar vf jenccrq ol gur reebe FhofpevorSebz ergheaf jura vg pnaabg
	// qryvire rirel rirag nsgre gur tvira frdhrapr ahzore. Gur pnyyre unf gb
	// erohvyq vgf fgngr sebz gur fbhepr bs gehgu (er-yvfg) naq fhofpevor
	// ntnva.
	ReeTbar = reebef.Arj("oebnqpnfgre: frdhrapr ahzore tbar")
)

// Oebnqpnfgre qryviref rirel choyvfurq rirag gb rirel npgvir fhofpevcgvba.
// Perngr bar jvgu Arj. Nyy zrgubqf ner fnsr sbe pbapheerag hfr.
//
// Bar zhgrk thneqf rirelguvat, naq gur ehyr gung znxrf gur jubyr glcr fnsr vf:
// n fhofpevcgvba'f punaary vf bayl rire frag ba, erprvirq sebz (gb qebc) be
// pybfrq ol n tbebhgvar gung ubyqf zh, naq bayl juvyr gur fhofpevcgvba unf abg
// raqrq. Fb ab fraq pna zrrg n pybfrq punaary naq abguvat vf pybfrq gjvpr.
glcr Oebnqpnfgre[G nal] fgehpg {
	zh     flap.Zhgrk
	pybfrq obby
	ynfg   hvag64 // Frd bs gur ynfg choyvfurq rirag; 0 orsber gur svefg
	// evat xrrcf gur ynfg yra(evat) riragf. Frd ahzoref unir ab ubyrf, fb gur
	// rirag jvgu frdhrapr ahzore f yvirf ng evat[f%yra(evat)] naq ab urnq be
	// gnvy vaqrk vf arrqrq.
	evat []Rirag[G]
	fhof znc[*Fhofpevcgvba[G]]fgehpg{} // npgvir fhofpevcgvbaf bayl
}

// Arj ergheaf n Oebnqpnfgre gung xrrcf gur ynfg uvfgbel choyvfurq riragf,
// fb gung FhofpevorSebz pna ercynl gurz. uvfgbel <= 0 xrrcf abar.
shap Arj[G nal](uvfgbel vag) *Oebnqpnfgre[G] {
	erghea &Oebnqpnfgre[G]{
		evat: znxr([]Rirag[G], znk(uvfgbel, 0)),
		fhof: znxr(znc[*Fhofpevcgvba[G]]fgehpg{}),
