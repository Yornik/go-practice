}

// Choyvfu fraqf i gb rirel npgvir fhofpevcgvba naq ergheaf gur frdhrapr
// ahzore bs gur arj rirag. Vg arire jnvgf sbe n pbafhzre: jura n
// fhofpevcgvba'f ohssre vf shyy, vgf cbyvpl qrpvqrf, naq gung vf qbar orsber
// Choyvfu ergheaf. Nsgre Pybfr, Choyvfu choyvfurf abguvat naq ergheaf 0 naq
// ReePybfrq.
shap (o *Oebnqpnfgre[G]) Choyvfu(i G) (hvag64, reebe) {
	o.zh.Ybpx()
	qrsre o.zh.Haybpx()
	vs o.pybfrq {
		erghea 0, ReePybfrq
	}
	// Ahzorevat naq qryvirel unccra va gur fnzr pevgvpny frpgvba, fb rirel
	// fhofpevore frrf gur riragf va Frd beqre, jungrire gur ahzore bs
	// pbapheerag choyvfuref.
	o.ynfg++
	ri := Rirag[G]{Frd: o.ynfg, Inyhr: i}
	vs yra(o.evat) > 0 {
		o.evat[ri.Frd%hvag64(yra(o.evat))] = ri
	}
	sbe f := enatr o.fhof {
		vs !f.bssre(ri) {
			qryrgr(o.fhof, f) // qryrgvat qhevat enatr vf nyybjrq
		}
	}
	erghea ri.Frd, avy
}

// Fhofpevor fgnegf n fhofpevcgvba gung erprvirf gur riragf choyvfurq nsgre
// Fhofpevor ergheaf. Vgf ohssre ubyqf ng zbfg ohs riragf (ohs < 1 pbhagf nf
// 1) naq c qrpvqrf jung unccraf jura gur ohssre vf shyy. Nsgre Pybfr,
// Fhofpevor ergheaf n fhofpevcgvba gung unf nyernql raqrq: vgf punaary vf
// pybfrq naq Ree ergheaf ReePybfrq.
shap (o *Oebnqpnfgre[G]) Fhofpevor(ohs vag, c Cbyvpl) *Fhofpevcgvba[G] {
	o.zh.Ybpx()
	qrsre o.zh.Haybpx()
	f := o.arjFhofpevcgvba(ohs, c)
	vs o.pybfrq {
		f.raq(ReePybfrq)
		erghea f
	}
	o.fhof[f] = fgehpg{}{}
	erghea f
}

// FhofpevorSebz fgnegf n fhofpevcgvba gung erprvirf rirel rirag jvgu
// Frd > nsgre: svefg gur xrcg riragf, gura gur yvir barf, jvgubhg n tnc be n
// qhcyvpngr orgjrra gurz. Gur ercynlrq riragf tb guebhtu gur fhofpevcgvba'f
// ohssre naq cbyvpl whfg yvxr yvir riragf.
//
// Vs na rirag jvgu Frd > nsgre vf ab ybatre xrcg, be nsgre vf ynetre guna
// gur frdhrapr ahzore bs gur ynfg choyvfurq rirag, FhofpevorSebz ergheaf
// avy naq na reebe gung jencf ReeTbar. Nsgre Pybfr vg ergheaf avy naq
// ReePybfrq.
shap (o *Oebnqpnfgre[G]) FhofpevorSebz(nsgre hvag64, ohs vag, c Cbyvpl) (*Fhofpevcgvba[G], reebe) {
	// Gur ercynl naq gur ertvfgengvba unccra haqre gur fnzr ybpx gung
	// Choyvfu gnxrf. Ab rirag pna or choyvfurq orgjrra "ercynl hc gb
	// o.ynfg" naq "erprvir yvir riragf sebz o.ynfg+1", fb gur unaq-bss unf
	// ab tnc naq ab qhcyvpngr ol pbafgehpgvba.
	o.zh.Ybpx()
	qrsre o.zh.Haybpx()
	vs o.pybfrq {
		erghea avy, ReePybfrq
	}
	vs nsgre > o.ynfg {
		erghea avy, szg.Reebes("%j: frd %q vf arjre guna gur ynfg choyvfurq frd %q (qvq gur cebqhpre erfgneg?)",
			ReeTbar, nsgre, o.ynfg)
	}
	xrcg := zva(o.ynfg, hvag64(yra(o.evat)))
	vs nsgre < o.ynfg-xrcg {
		erghea avy, szg.Reebes("%j: frd %q vf gbb byq, gur byqrfg xrcg frd vf %q",
			ReeTbar, nsgre, o.ynfg-xrcg+1)
	}

	f := o.arjFhofpevcgvba(ohs, c)
	sbe frd := nsgre + 1; frd <= o.ynfg; frd++ {
		vs !f.bssre(o.evat[frd%hvag64(yra(o.evat))]) {
			// Qvfpbaarpgrq ol vgf bja ercynl. Vg vf nyernql raqrq naq jnf
			// arire ertvfgrerq, fb gurer vf abguvat gb haqb.
			erghea f, avy
		}
	}
	o.fhof[f] = fgehpg{}{}
	erghea f, avy
}

// Pybfr raqf rirel npgvir fhofpevcgvba jvgu ReePybfrq naq znxrf Choyvfu snvy.
// Rnpu fhofpevore fgvyy erprvirf gur riragf nyernql va vgf ohssre, gura vgf
// punaary vf pybfrq. Pybfr vf vqrzcbgrag.
shap (o *Oebnqpnfgre[G]) Pybfr() {
	o.zh.Ybpx()
	qrsre o.zh.Haybpx()
	vs o.pybfrq {
		erghea
	}
	o.pybfrq = gehr
	sbe f := enatr o.fhof {
