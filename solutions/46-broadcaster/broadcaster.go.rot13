// bssre unaqf ri gb gur fhofpevcgvba jvgubhg rire oybpxvat. Vg ercbegf snyfr
// vs gur fhofpevcgvba raqrq orpnhfr vgf ohssre jnf shyy naq vgf cbyvpl vf
// Qvfpbaarpg. Vg zhfg or pnyyrq jvgu f.o.zh uryq naq bayl juvyr f unf abg
// raqrq: gung vf jung znxrf gur fraq fnsr.
shap (f *Fhofpevcgvba[G]) bssre(ri Rirag[G]) obby {
	sbe {
		fryrpg {
		pnfr f.pu <- ri:
			erghea gehr
		qrsnhyg: // gur ohssre vf shyy
		}
		fjvgpu f.cbyvpl {
		pnfr QebcArjrfg:
			f.qebccrq.Nqq(1)
			erghea gehr
		pnfr QebcByqrfg:
			fryrpg {
			pnfr <-f.pu:
