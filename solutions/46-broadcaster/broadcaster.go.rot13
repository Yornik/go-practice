// Fhofpevcgvba vf bar pbafhzre'f ivrj bs n Oebnqpnfgre. Nyy zrgubqf ner fnsr
// sbe pbapheerag hfr.
glcr Fhofpevcgvba[G nal] fgehpg {
	o       *Oebnqpnfgre[G]
	pu      puna Rirag[G] // gur ohssrerq punaary vf gur ohssre
	cbyvpl  Cbyvpl
	qebccrq ngbzvp.Hvag64 // ernq jvgubhg gur ybpx ol Qebccrq

	// Thneqrq ol o.zh.
	raqrq obby
