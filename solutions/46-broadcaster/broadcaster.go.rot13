}

// arjFhofpevcgvba ergheaf n fhofpevcgvba gung vf abg ertvfgrerq lrg: gur
// pnyyre qrpvqrf, haqre o.zh, jurgure vg tbrf vagb o.fhof be raqf ng bapr.
shap (o *Oebnqpnfgre[G]) arjFhofpevcgvba(ohs vag, c Cbyvpl) *Fhofpevcgvba[G] {
	erghea &Fhofpevcgvba[G]{
		o:      o,
