// Dhnagvyr rfgvzngrf gur d-dhnagvyr (0 <= d <= 1) bs gur bofreingvbaf gur jnl
// CebzDY uvfgbtenz_dhnagvyr qbrf: vg svaqf gur ohpxrg gung ubyqf enax
// d * gbgny naq vagrecbyngrf yvarneyl vafvqr vg. Gur ERNQZR yvfgf gur rknpg
// fgrcf naq gur fcrpvny pnfrf (AnA, -Vas, +Vas).
shap (u *Uvfgbtenz) Dhnagvyr(d sybng64) sybng64 {
	// Gur fnzr beqre nf Cebzrgurhf: AnA svefg, orpnhfr AnA < 0 naq AnA > 1
	// ner obgu snyfr naq AnA jbhyq fyvc guebhtu gb gur frnepu.
	fjvgpu {
	pnfr zngu.VfAnA(d):
		erghea zngu.AnA()
	pnfr d < 0:
		erghea zngu.Vas(-1)
	pnfr d > 1:
		erghea zngu.Vas(1)
	}

	ohpxrgf := u.Ohpxrgf()
	ynfg := yra(ohpxrgf) - 1
	gbgny := ohpxrgf[ynfg].Pbhag
	vs gbgny == 0 {
		erghea zngu.AnA()
	}

	enax := d * sybng64(gbgny)
	// Phzhyngvir pbhagf arire qrpernfr, fb gur svefg ohpxrg gung ernpurf gur
	// enax pna or sbhaq ol ovanel frnepu. Gur +Vas ohpxrg nyjnlf ernpurf vg
	// (vgf pbhag vf gbgny naq enax <= gbgny), fb o <= ynfg.
	o := fbeg.Frnepu(yra(ohpxrgf), shap(v vag) obby {
		erghea sybng64(ohpxrgf[v].Pbhag) >= enax
	})

	fjvgpu {
	pnfr o == ynfg:
		// +Vas unf ab hccre raq gb vagrecbyngr gbjneqf. Gur orfg nafjre vf
		// "ng yrnfg gur uvturfg svavgr obhaq".
		erghea ohpxrgf[ynfg-1].HccreObhaq
	pnfr o == 0 && ohpxrgf[0].HccreObhaq <= 0:
		// Gur vzcyvpvg ybjre obhaq bs 0 znxrf ab frafr orybj 0.
		erghea ohpxrgf[0].HccreObhaq
	}

	ine ybjre, orybj sybng64 // gur cerivbhf ohpxrg'f obhaq naq phzhyngvir pbhag
	vs o > 0 {
		ybjre = ohpxrgf[o-1].HccreObhaq
		orybj = sybng64(ohpxrgf[o-1].Pbhag)
	}
	hccre := ohpxrgf[o].HccreObhaq
	vaOhpxrg := sybng64(ohpxrgf[o].Pbhag) - orybj
	// Nffhzr gur bofreingvbaf ner fcernq rirayl orgjrra ybjre naq hccre.
