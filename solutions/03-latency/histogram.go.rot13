// uvfgbtenz xrrcf vgf bja pbcl bs gur obhaqf, fb gur pnyyre znl erhfr gur
// fyvpr nsgrejneqf.
shap ArjUvfgbtenz(hccreObhaqf []sybng64) (*Uvfgbtenz, reebe) {
	vs yra(hccreObhaqf) == 0 {
